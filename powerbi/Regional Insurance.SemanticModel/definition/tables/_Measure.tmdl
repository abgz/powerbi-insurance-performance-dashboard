	measure 'temp_lapsed Policy Count' =
			
			VAR _asOf = MAX ( dim_date[date] )
			VAR _asOfKey = YEAR ( _asOf ) * 10000 + MONTH ( _asOf ) * 100 + DAY ( _asOf )
			VAR _issued =
			    CALCULATE (
			        DISTINCTCOUNT ( fact_persistency[policy_id] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_persistency[issue_date_key] <= _asOfKey
			    )
			VAR _lapsed =
			    CALCULATE (
			        DISTINCTCOUNT ( fact_persistency[policy_id] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_persistency[issue_date_key] <= _asOfKey,
			        fact_persistency[renewal_due_date_key] <= _asOfKey,
			        fact_persistency[renewal_status] = "lapsed"
			    )
			RETURN
			     _lapsed
		formatString: 0
		lineageTag: 5828f7c2-9377-4ff3-99ba-721c6e3a1cbc

	measure 'APE vs Target %' =
			
			//DIVIDE(
			//    [Total APE]-SUM(fact_target[ape_target_usd]),
			//    SUM(fact_target[ape_target_usd]),
			//    0
			//)
			
			DIVIDE(
			    [Total APE],
			    sum(fact_target[ape_target_usd]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f91cdee6-836c-4fe4-a533-8a9fe1a7b209

	measure 'Agent Card HTML' = ```
			
			   VAR _name  = SELECTEDVALUE ( dim_agent[agent_name], "Select an agent" )
			   VAR _terr  = SELECTEDVALUE ( dim_agent[territory], "" )
			   VAR _ape   = [APE YTD]
			   VAR _rank  = [Agent Rank by APE]
			   VAR _mom   = [APE MoM Growth %]
			   VAR _arrow = IF ( _mom >= 0, "▲", "▼" )
			   VAR _col   = IF ( _mom >= 0, "#2e7d32", "#c62828" )
			   VAR _prod  = [Top Product Name by APE]
			   VAR _pers  = [Persistency Rate]
			   RETURN
			   "<div style='font-family:Segoe UI,sans-serif;padding:16px;border-radius:8px;border:1px solid #ddd'>"
			   & "<div style='font-size:22px;font-weight:600'>" & _name & "</div>"
			   & "<div style='color:#666;margin-bottom:12px'>Territory: " & _terr & "</div>"
			   & "<div style='font-size:28px'>$" & FORMAT ( _ape, "#,##0" ) & "</div>"
			   & "<div>YTD APE &nbsp;|&nbsp; Rank #" & _rank & "</div>"
			   & "<div style='color:" & _col & ";margin-top:8px'>" & _arrow & " "
			   & FORMAT ( ABS ( _mom ), "0.0%" ) & " vs last month</div>"
			   & "<div style='margin-top:8px'>Top product: <b>" & _prod & "</b></div>"
			   & "<div>Persistency: <b>" & FORMAT ( _pers, "0.0%" ) & "</b></div>"
			   & "</div>"
			```
		lineageTag: 8f4d6fb9-a679-401e-8611-e862a964d447

	measure '___Policy renewed/persisited' =
			
			COUNTROWS(FILTER(fact_persistency,fact_persistency[renewal_status]="renewed"))
		formatString: 0
		lineageTag: b5ef1b14-8922-44df-b266-a80e77852ce9

	measure '___Policies issued' = COUNT(fact_persistency[policy_id])
		formatString: #,0
		lineageTag: 4a641a34-bedd-415c-8895-9e24f41e53cb

	measure 'Top Product Name by APE' =
			
			VAR _top =
			    TOPN (
			        1,
			        VALUES ( dim_product[product_name] ),
			        [Total APE],
			        DESC
			    )
			RETURN
			    MAXX ( _top, dim_product[product_name] )
		lineageTag: 4fb33fdc-c0ef-476f-a8c6-0e5cbe33e1da

	measure 'Total APE (Known Agents)' =
			
			CALCULATE (
			    [Total APE],
			    dim_agent[agent_name] <> BLANK ()
			)
		lineageTag: 660046ce-d992-4a2a-9411-9cd75db4e9a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

