table _Measure
	lineageTag: 890c8391-93bb-488a-84e0-4b5969f3170d

	measure 'APE YTD' = ```
			
			TOTALYTD(
			    SUM(fact_sales[ape_usd])
			    ,dim_date[date]
			    )
			
			
			```
		formatString: 0
		lineageTag: 54cc3496-c90d-4a66-8cc1-8eb348605a60

	measure 'Total APE' = SUM(fact_sales[ape_usd])
		lineageTag: 2ac41e2d-6d6e-4abb-a2c8-683ba00c96e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'APE MoM Growth %' = ```
			
			var prevMonth = CALCULATE(
			                    [Total APE],
			                    DATEADD(dim_date[date],-1,MONTH)
			                        )
			var currMonth=[Total APE]
			
			var mom = 
			    if(
			        not ISBLANK(currMonth) && not isblank(prevMonth),
			        currMonth - prevMonth,
			        BLANK()
			    )
			RETURN DIVIDE(mom,prevMonth,BLANK())
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 72179114-915c-445a-aa2b-d8f1ea57bbb6

	measure 'APE Rolling 3 Months' =
			
			
			CALCULATE(
			        [Total APE],
			        DATESINPERIOD(
			            dim_date[date],
			            MAX(dim_date[date]),
			            -3,
			            MONTH
			        )
			)
		lineageTag: ebc485eb-1c44-40a3-95d2-ed634c9eb870

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Persistency Rate' = ```
			
			   var result= DIVIDE(
			        COUNTROWS( FILTER( fact_persistency, fact_persistency[renewal_status] = "renewed" ) ),
			        COUNTROWS( FILTER( fact_persistency,
			            fact_persistency[renewal_status] IN { "renewed", "lapsed", "grace" } ) )
			    )
			RETURN 
			    result
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 49c432df-a515-40af-b94a-23f2c5938e5a

	measure 'Active Agent Count' = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(dim_agent[agent_id]),
			            dim_agent[active_flag]=1
			    )
			```
		formatString: 0
		lineageTag: 67f6e474-7c7f-4de0-beb9-70fd1611ca1a

	measure 'Agent Rank by APE' = ```
			
			RANKx(     
			    ALLSELECTED(dim_agent),
			        ([Total APE]),
			             ,     
			             DESC,     
			             Dense)
			```
		formatString: 0
		lineageTag: 7c14200f-7cb8-4393-b5b8-05d98fec7f1f

	measure 'Active Policy Count' =
			
			VAR _asOf = MAX ( dim_date[date] )
			VAR _asOfKey = YEAR ( _asOf ) * 10000 + MONTH ( _asOf ) * 100 + DAY ( _asOf )
			VAR _issued =
			    CALCULATE (
			        DISTINCTCOUNT ( fact_persistency[policy_id] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_persistency[issue_date_key] <= _asOfKey
			    )
			VAR _lapsed =
			    CALCULATE (
			        DISTINCTCOUNT ( fact_persistency[policy_id] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_persistency[issue_date_key] <= _asOfKey,
			        fact_persistency[renewal_due_date_key] <= _asOfKey,
			        fact_persistency[renewal_status] = "lapsed"
			    )
			RETURN
			    _issued - _lapsed
		formatString: 0
		lineageTag: d6f9e177-4f4e-419d-989c-75434bf56374

