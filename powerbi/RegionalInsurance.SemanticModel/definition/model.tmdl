model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_agent","dim_date","dim_product","fact_persistency","fact_sales","fact_target"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_agent
ref table dim_date
ref table dim_product
ref table fact_persistency
ref table fact_sales
ref table _Measure
ref table fact_target
ref table bridge_month

ref role 'Territory Manager'

ref cultureInfo en-US

